<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TukangSayurOnline.Mobile"
             xmlns:components="clr-namespace:TukangSayurOnline.Mobile.Components"
             x:Class="TukangSayurOnline.Mobile.MainPage"
             BackgroundColor="#0f172a">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" HorizontalOptions="Fill" VerticalOptions="Fill">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
